# Forti Docker Compose environment variables
#
# Copy this file to `.env` and customize as needed.
# See README.md for details.

# Reverse proxy configuration
# Set DOMAIN to enable automatic HTTPS (e.g., forti.example.com)
# Leave as localhost for local development with HTTP only
#DOMAIN=localhost
#HTTP_PORT=80
#HTTPS_PORT=443

# Data paths (relative to this directory)
#FORECAST_DATA_PATH=../data/forecast
#TOPOGRAPHY_DATA_PATH=../data/topography

# jsonfrontend output mapping: which forecast parameters are served, and under what names
#JSONFRONTEND_CONFIG=./jsonfrontend.config.json

# Enable correctedforecaster (uncomment both lines)
#COMPOSE_PROFILES=corrected
#JSONFRONTEND_UPSTREAM=correctedforecaster:5051

# Container registry and tag
#FORTI_REGISTRY=ghcr.io/metno
#FORTI_TAG=latest
